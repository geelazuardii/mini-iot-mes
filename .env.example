# Salin file ini jadi .env lalu isi. JANGAN commit .env
PORT=3000

# Koneksi PostgreSQL (Supabase: pakai "Session pooler" connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
# true untuk Supabase / DB cloud, false untuk Postgres lokal
DB_SSL=false

# Device key per mesin (dipakai ESP32 di header X-Device-Key)
# Nilai di bawah cuma contoh, ganti kalau dipakai sungguhan
DEVICE_KEY_MC_01=demo-key-mc-01
DEVICE_KEY_MC_02=demo-key-mc-02
DEVICE_KEY_MC_03=demo-key-mc-03

# Opsional untuk tools/sim-device.js
# SIM_BASE_URL=http://localhost:3000
# SIM_INTERVAL_SEC=5
